{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-unrestricted",
  "description": "Main window. Grants unrestricted local filesystem access (any drive, any folder) and unrestricted HTTP(S) access, because the toolbox must be able to open, read and rewrite game files anywhere the user points it at.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-set-position",
    "core:window:allow-center",
    "core:app:allow-version",
    "core:app:allow-name",

    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-truncate",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "**" },
        { "path": "**/*" },
        { "path": "*" }
      ]
    },

    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",

    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "http://**" },
        { "url": "https://**" },
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }, { "path": "**/*" }]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "**" }, { "path": "**/*" }]
    }
  ]
}
