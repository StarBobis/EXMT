{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EXMT Modbox",
  "version": "0.1.0",
  "identifier": "com.exmt.modbox",
  "build": {
    "beforeDevCommand": "node scripts/dev.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EXMT Modbox",
        "width": 1120,
        "height": 630,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "bin/texconv.exe",
      "bin/DirectXTex-LICENSE.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
